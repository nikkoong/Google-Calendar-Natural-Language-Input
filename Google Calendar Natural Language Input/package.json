{
  "name": "gcal-natural-lang-input",
  "version": "2.4.1",
  "description": "Quickly create Google Calendar events from natural language.",
  "main": "index.js",
  "scripts": {
    "test": "node tests/run-tests.js",
    "test:built": "node tests/built-files.test.cjs",
    "test:all": "npm test && npm run test:built",
    "test:watch": "nodemon --watch src --watch tests --exec \"npm test\"",
    "build": "rollup -c rollup.config.improved.mjs",
    "watch": "rollup -c rollup.config.improved.mjs --watch"
  },
  "type": "module",
  "author": "Nicholas Ong",
  "license": "MIT",
  "devDependencies": {
    "archiver": "^7.0.1",
    "chrono-node": "^2.7.5",
    "dayjs": "^1.11.10",
    "nodemon": "^3.0.1",
    "rollup": "^4.12.1",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-multi-input": "^1.4.1",
    "rollup-plugin-node-resolve": "^5.2.0"
  }
}
